# RansomShield AI — Production & Development Environment Configuration
# =====================================================================
# INSTRUCTIONS:
# Copy this template to `.env` in the repository root.
# In PRODUCTION (ENVIRONMENT="production"), all security values MUST be explicitly
# set with high-entropy cryptographic secrets. Default placeholders are blocked.
# =====================================================================

# --- General Service Settings ---
APP_NAME="RansomShield AI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"               # "production", "development", or "testing"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# --- Database Configuration (MongoDB) ---
DATABASE_BACKEND="auto"                 # Options: "auto", "mongodb", "memory"
# MONGODB_URI="mongodb://user:password@localhost:27017/ransomshield_db?authSource=admin"
MONGODB_DATABASE="ransomshield_db"
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MONGODB_CONNECT_TIMEOUT_MS=2000

# --- Production CORS Whitelist ---
# Comma-separated allowed frontend origins. Never use "*" in production.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# --- Authentication & JWT Security ---
# In production, MUST be at least 32 high-entropy random characters (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Agent Authentication ---
# Pre-shared key for Windows monitoring agents. In production, MUST be at least 16 chars.
AGENT_API_KEY="REPLACE_WITH_MINIMUM_16_CHAR_AGENT_SECRET_KEY"

# --- Rate Limiting & Resource Protection ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RESPONSE_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=10485760         # 10 Megabytes

# --- Agent Monitoring & Record Limits ---
AGENT_HEARTBEAT_TIMEOUT_SECONDS=60
MAX_IN_MEMORY_RECORDS=1000

# --- Phase 4: Defensive Response & Containment ---
RESPONSE_DRY_RUN=true                   # Default to true for safe simulation
REQUIRE_TWO_PERSON_APPROVAL=true        # Enforce multi-person sign-off for critical actions
QUARANTINE_DIRECTORY="data/quarantine"
